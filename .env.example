# Copy to .env locally (never commit .env). In CI these come from GitHub Secrets.

# YouTube Data API v3 / Analytics API (OAuth, "Published" app -> refresh token doesn't expire)
YT_CLIENT_ID=
YT_CLIENT_SECRET=
YT_REFRESH_TOKEN=

# Kaggle (for generate/kaggle_acestep.py)
KAGGLE_USERNAME=
KAGGLE_KEY=

# Storage (pick one, matches config.yaml storage:)
GDRIVE_REFRESH_TOKEN=
HF_TOKEN=

# Images
PEXELS_API_KEY=

# Text/SEO
GEMINI_API_KEY=

# Notifications
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Optional failover
MODAL_TOKEN_ID=
MODAL_TOKEN_SECRET=
