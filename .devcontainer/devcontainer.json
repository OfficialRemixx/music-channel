{
  "name": "music-channel",
  "image": "mcr.microsoft.com/devcontainers/python:1-3.12-bullseye",
  "postCreateCommand": "pip install -r requirements.txt && pip install ruff pytest",
  "customizations": {
    "vscode": {
      "extensions": ["ms-python.python", "charliermarsh.ruff"]
    }
  },
  "remoteEnv": {
    "FORCE_DRY_RUN": "true"
  }
}
